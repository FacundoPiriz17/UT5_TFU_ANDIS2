# Proyecto separado de las entregas anteriores.
COMPOSE_PROJECT_NAME=ut5_service_based
API_PORT=8055
FRONTEND_PORT=3255
CATALOGO_PORT=8056
COMERCIAL_PORT=8057
KEYCLOAK_PORT=8155
CATALOGO_VERSION=v1
COMERCIAL_VERSION=v1
BASE_URL=http://localhost:8055
KEYCLOAK_URL=http://localhost:8155
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=AdminDemo123!
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=db_games
MYSQL_USER=db_user
MYSQL_PASSWORD=db_password
# Comunicación interna: DNS Compose y puertos de contenedor, definidos en Compose.
SOAP_CONNECT_TIMEOUT=0.35
SOAP_READ_TIMEOUT=0.7
SOAP_TOTAL_BUDGET=3
SOAP_MAX_ATTEMPTS=3
SOAP_RETRY_BACKOFF=0.1
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=5
REDIS_TIMEOUT_SECONDS=0.1
# Opcionales; los valores por defecto se derivan de los puertos anteriores.
# OIDC_ISSUER=http://localhost:8155/realms/andis-ut4
# CATALOGO_SOAP_URL=http://catalogo:8000/soap/catalogo
# CATALOGO_HTTP_URL=http://catalogo:8000
# CATALOGO_PUBLIC_SOAP_URL=http://localhost:8055/soap/catalogo
# Para scripts autenticados: access token vigente, nunca se versiona ni se imprime.
# DEMO_ACCESS_TOKEN=
